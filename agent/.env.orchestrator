# llama-server (sourced by scripts/run-llama-server.sh)
# See also: BINARY_PATH, MODEL_PATH, PROJ_PATH, PORT

NGL=99
CTX_SIZE=4096
BATCH=1024
PREDICT=1024
THREADS=8

TEMP=0.2
TOP_P=0.9
TOP_K=40

JINJA=1
FLASH_ATTN=on
CNV=1
MLOCK=0

# Python orchestrator (unquoted; GRPC_TIMEOUT_S in seconds, e.g. 4.0)
LLAMA_CPP_URL=http://127.0.0.1:8080
MODEL_NAME=gemma-4-e2b
GRPC_TARGET=192.168.4.1:50051
GRPC_TIMEOUT_S=4.0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Optional local test mode (no gRPC).
# When enabled, orchestrator waits for each mission prompt on stdin, plans with fake telemetry,
# logs mission points, and skips StartMission upload. One-shot from shell: echo '...' | uv run python -m agent.orchestrator.loops
LOCAL_TEST_MODE=1
LOCAL_TEST_LATITUDE_DEG=47.3977419
LOCAL_TEST_LONGITUDE_DEG=8.5455938
LOCAL_TEST_RELATIVE_ALTITUDE_M=0.0
LOCAL_TEST_ABSOLUTE_ALTITUDE_M=488.0
MISSION_JSON_LOG_ENABLED=1
MISSION_JSON_LOG_PATH=agent/logs/mission_pipeline.jsonl

# ArduCam + Hailo YOLO (python -m agent.orchestrator.loops)
# This file is sourced by agent/scripts/run-llama-server.sh only for llama options.
# Export these for the orchestrator process the same way you load other orchestrator vars (wrapper script / shell).
ARDUCAM_VISION=1

# Raspberry Pi: Picamera2 is not declared in pyproject (uv.lock would pull Linux-only transitive
# deps on macOS). In your Pi venv run: uv pip install "picamera2>=0.3.31"
# Also available via: sudo apt install python3-picamera2 (matches system Python).
# When ARDUCAM_VISION=1, loops sets YOLO_BACKEND=hailo if unset. Override if needed:
YOLO_BACKEND=hailo
YOLO_HEF_PATH=agent/models/yolo26n_b8.hef
# Full-res: partition frame into N=rows*cols cells (see README). Omitted or 1 = whole frame.
YOLO_NUMBER_TILES=16

# Record downsampled stream with overlays to a new timestamped file per run.
# Relative to MissionAgent repo root (make run-loops cd's there). Override with an absolute path if you start loops from elsewhere.
ARDUCAM_VIDEO_DIR=agent/arducamvideos
ARDUCAM_RECORD_FPS=15

# Person log: consecutive recorder frames above confidence before INFO log:
ARDUCAM_PERSON_CONF=0.5
ARDUCAM_PERSON_FRAMES=3

# Optional Picamera capture sizes (Arducam 64MP defaults below):
CAPTURE_SIZE=4624x3472
STREAM_DISPLAY_SIZE=1280x960

# DETECTION_DEBUG_LOG=1

# --- Person rescue trigger ---
# Multimodal follow-up after rescue (crop + second LLM prompt). Set to 0 to skip analysis,
# start llama-server without --mmproj, and save only the annotated full-frame JPEG (no *_person.jpg).
# RESCUE_IMAGE_LLM_ENABLED=1
RESCUE_PERSON_CONF=0.75
RESCUE_PERSON_FRAMES=5
# Seconds after the first operator mission is sent before the rescue trigger arms.
# Prevents the operator standing beside the drone at takeoff from being detected.
RESCUE_ARM_DELAY_S=60.0
RESCUE_PHOTOS_DIR=agent/arducamphotos
# RESCUE_MIN_RTH_ALT_M=10.0

# Optional hard-coded home location (set both to override first-takeoff capture):
# RESCUE_HOME_LATITUDE_DEG=
# RESCUE_HOME_LONGITUDE_DEG=
# RESCUE_HOME_RELATIVE_ALTITUDE_M=0.0

# --- Camera geometry for person-offset estimation (Arducam 64MP defaults) ---
# CAMERA_MOUNT_PITCH_DEG=90.0
# CAMERA_HFOV_DEG=66.0
# CAMERA_VFOV_DEG=41.0
